digraph pipeline_stages {
  rankdir=LR;
  bgcolor="white";
  labelloc="t"; fontname="Helvetica-Bold"; fontsize=20;
  label="Stages and files — who writes what in the song's cache dir";
  node [fontname="Helvetica", fontsize=10, style="filled", penwidth=1.2];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  mp3 [label="MP3", shape=note, fillcolor="#fff2cc"];
  xl  [label="xLights\n(live)", shape=cylinder, fillcolor="#fff2cc"];
  xsq [label="<seq>.xsq\n+ audio + timing", shape=note, fillcolor="#fff2cc"];

  // stages (code)
  analyze  [label="xlo analyze", shape=box, fillcolor="#d7e3f4"];
  groups   [label="xlo groups", shape=box, fillcolor="#d7e3f4"];
  validate [label="xlo validate-brief", shape=box, fillcolor="#d7e3f4"];
  realize  [label="xlo realize", shape=box, fillcolor="#dcedda"];
  apply    [label="xlo apply\n(--render)", shape=box, fillcolor="#cfe9df"];
  qa       [label="xlo qa", shape=box, fillcolor="#dcedda"];
  stills   [label="xlo stills", shape=box, fillcolor="#dcedda"];
  finalize [label="xlo finalize", shape=box, fillcolor="#cfe9df"];
  vplan    [label="xlo video-plan", shape=box, fillcolor="#d7e3f4"];

  // Claude (judgment)
  claude [label="Claude\n(in conversation\nwith the user)", shape=oval, fillcolor="#f3d9e6"];

  // files
  sa     [label="song_analysis.json", shape=ellipse, fillcolor="#f0f0f0"];
  digest [label="analysis_digest.md", shape=ellipse, fillcolor="#f0f0f0"];
  vocab  [label="vocab.json\n+ schema, layout.json", shape=ellipse, fillcolor="#f0f0f0"];
  brief  [label="creative_brief.json", shape=ellipse, fillcolor="#f8e1ec"];
  val    [label="validation.json", shape=ellipse, fillcolor="#f0f0f0"];
  ins    [label="instructions.json", shape=ellipse, fillcolor="#f0f0f0"];
  appl   [label="applied.json", shape=ellipse, fillcolor="#f0f0f0"];
  fseq   [label="<seq>.fseq", shape=ellipse, fillcolor="#f0f0f0"];
  qaj    [label="qa.json", shape=ellipse, fillcolor="#f0f0f0"];
  png    [label="stills/*.png", shape=ellipse, fillcolor="#f0f0f0"];
  story  [label="video_story.json", shape=ellipse, fillcolor="#f8e1ec"];
  vs     [label="media_plan.json\nvideo_script.json/.md", shape=ellipse, fillcolor="#f0f0f0"];

  mp3 -> analyze -> sa; analyze -> digest;
  xl -> groups [style=dashed]; sa -> groups; groups -> vocab;
  digest -> claude; vocab -> claude;
  claude -> brief [label="writes", color="#b0306a"];
  brief -> validate; vocab -> validate; validate -> val;
  val -> claude [label="fix loop", style=dashed, color="#b0306a"];
  brief -> realize; realize -> ins;
  ins -> apply; apply -> xl [label="clean slate\n+ full emit"]; apply -> appl; apply -> fseq [style=dashed, label="--render"];
  ins -> qa; fseq -> qa [style=dashed]; appl -> qa; qa -> qaj;
  fseq -> stills; stills -> png;
  qaj -> claude [style=dashed]; png -> claude [style=dashed]; appl -> claude [style=dashed];
  brief -> finalize; xl -> finalize [style=dashed, label="save + close"]; finalize -> xsq;
  brief -> vplan; claude -> story [label="writes", color="#b0306a"]; story -> vplan; vplan -> vs;
}
