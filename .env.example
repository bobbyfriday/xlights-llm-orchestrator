# ─────────────────────────────────────────────────────────────────────────────
# xLights LLM Orchestrator — environment template.
# Copy to .env and fill in. .env is gitignored; never commit real secrets.
# No model API key is needed: the creative work happens in your Claude Code
# session, and the `xlo` stage commands make no model calls.
# ─────────────────────────────────────────────────────────────────────────────

# --- xLights automation API (required for groups/apply/finalize) ---------------
# xLights must be running with the automation/REST listener enabled
# (Preferences → Output → xFade port → A). Instance "A" = 49913, "B" = 49914.
XLIGHTS_BASE_URL=http://127.0.0.1:49913

# --- Song cache ---------------------------------------------------------------
# Where the audio analysis and every stage file live: each song gets
# $XLO_CACHE_DIR/orchestrator/<song-slug>--<hash>/ (`xlo analyze` prints it).
XLO_CACHE_DIR=data/analyses

# --- Lyrics (optional) ----------------------------------------------------------
# Genius: https://genius.com/api-clients — timed lyrics, lyric-derived sections,
# lyric color-word triggers, singing faces, matrix captions.
GENIUS_ACCESS_TOKEN=

# --- Stem separation (optional) -------------------------------------------------
# Stems are requested by default; these override the demucs backend/model.
# XLO_STEMS_BACKEND=torch          # default: demucs-mlx (Apple Silicon)
# XLO_STEMS_MODEL=htdemucs_6s

# --- QA (optional) --------------------------------------------------------------
# XLO_FSEQ_METRICS=0               # disable the rendered-pixel coverage metrics
