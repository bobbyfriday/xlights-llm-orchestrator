digraph system_overview {
  rankdir=TB;
  bgcolor="white";
  labelloc="t";
  fontname="Helvetica-Bold"; fontsize=20;
  label="xLights LLM Orchestrator — System Overview";
  node [fontname="Helvetica", fontsize=11, style="filled", penwidth=1.2];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  user [label="User", shape=oval, fillcolor="#e8eaf6"];

  // judgment: the Claude Code session
  subgraph cluster_claude {
    label="Claude Code session  (owns judgment)";
    style="rounded,filled"; fillcolor="#fbf3f7"; color="#d6a2c0"; fontname="Helvetica-Bold";
    commands [label="Commands  .claude/commands/xlo/\nanalyze · design · realize · apply\nreview · finalize · video · init-layout · show", shape=box, fillcolor="#f3d9e6"];
    skills   [label="Skills  .claude/skills/xlo-*\nbrief · sequencing · scenes\nlayout · video", shape=box, fillcolor="#f3d9e6"];
    guides   [label="Root guides (hand-editable)\nsequencing · effects catalog · layering\nscene + trigger cookbooks · layout spec", shape=note, fillcolor="#efc9dc"];
  }

  // the files between the two halves
  brief [label="song cache dir\ncreative_brief.json  (Claude writes)\ndigest · vocab · validation · instructions\napplied · qa · stills · video_story", shape=folder, fillcolor="#fff2cc"];

  // realization: the deterministic CLI
  subgraph cluster_orch {
    label="xlights-orchestrator  (the xlo CLI — owns realization, no LLM)";
    style="rounded,filled"; fillcolor="#f4f7fb"; color="#9fb3c8"; fontname="Helvetica-Bold";
    stages [label="xlo stage commands\nanalyze · groups · validate-brief · realize\napply · qa · stills · finalize · video-plan · init-layout", shape=box, fillcolor="#d7e3f4"];
    det    [label="Deterministic realization\nscenes · bed · weave · beats · triggers\nphrasing · faces · matrix text · layer clamp", shape=box, fillcolor="#dcedda"];
    qa     [label="QA · stills\n(instructions + rendered .fseq)", shape=box, fillcolor="#dcedda"];
  }

  // tooling
  subgraph cluster_tooling {
    label="xlights-core  (tooling)";
    style="rounded,filled"; fillcolor="#eef7f3"; color="#86c7ad"; fontname="Helvetica-Bold";
    audio   [label="Audio analysis\nVAMP · librosa · stems · lyrics", shape=box, fillcolor="#e8e3f5"];
    emitter [label="effect_emitter → place_preset\n→ XLightsClient", shape=box, fillcolor="#cfe9df"];
    knowledge [label="Knowledge\npreset library · colors\nvalue curves · layout semantics", shape=box, fillcolor="#cfe9df"];
    offline [label="Offline .xsq patch\naudio · render order · timing", shape=box, fillcolor="#cfe9df"];
  }

  mcp     [label="xlights-mcp\n(optional live tools)", shape=box, fillcolor="#e8e3f5"];
  xlights [label="xLights\n(running instance, port 49913)", shape=cylinder, fillcolor="#fff2cc"];
  xsq     [label="Saved .xsq\n+ audio + timing tracks", shape=note, fillcolor="#fff2cc"];

  user -> commands [dir=both, label="conversation"];
  commands -> skills [label="load"];
  skills -> guides [label="read", style=dashed];
  commands -> stages [label="Bash: uv run xlo …"];
  commands -> brief [label="write brief /\nread results", dir=both];
  stages -> brief [dir=both, label="file in / file out"];
  audio -> stages [label="SongAnalysis"];
  stages -> det -> emitter;
  stages -> qa;
  knowledge -> emitter [label="looks / palettes", style=dashed];
  emitter -> xlights [label="HTTP: newSequence,\naddEffect, renderAll"];
  xlights -> offline [label="save + close", style=dashed];
  offline -> xsq;
  commands -> mcp [style=dotted];
  mcp -> xlights [style=dotted];
}
